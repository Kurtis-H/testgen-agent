{
  "openapi": "3.0.3",
  "info": { "title": "Bug Hunt Lab API", "version": "0.1.0" },
  "paths": {
    "/api/health": {
      "get": { "operationId": "health", "summary": "Health check", "responses": { "200": { "description": "OK" } } }
    },
    "/api/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List products, paginated, with optional case-insensitive name search. There are 23 products in total.",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 } },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Substring of the product name, case-insensitive" }
        ],
        "responses": {
          "200": { "description": "A page of products", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductPage" } } } },
          "400": { "description": "page or size is not a valid integer in range" }
        }
      }
    },
    "/api/signup": {
      "post": {
        "operationId": "signup",
        "summary": "Create an account. Email must be valid, password at least 8 characters, passwords must match, age 13 to 120, one account per email.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Signup" } } } },
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Validation errors" },
          "409": { "description": "Email already registered" }
        }
      }
    },
    "/api/search": {
      "get": {
        "operationId": "searchFruit",
        "summary": "Search fruit names containing q. The query 'error' always returns 500 (for testing error handling).",
        "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Results" }, "500": { "description": "Search failed" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": { "type": "object", "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "price": { "type": "number" }, "category": { "type": "string" } } },
      "ProductPage": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } }, "total": { "type": "integer" }, "page": { "type": "integer" }, "size": { "type": "integer" }, "totalPages": { "type": "integer" } } },
      "Signup": { "type": "object", "required": ["name", "email", "password", "confirm", "age"], "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 8 }, "confirm": { "type": "string" }, "age": { "type": "integer", "minimum": 13, "maximum": 120 } } }
    }
  }
}
